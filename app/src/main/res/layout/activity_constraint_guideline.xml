<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Layouts.Column">
    <TextView
        style="@style/Layouts.Title"
        android:text="@string/constraint_guideline" />

    <TextView
        style="@style/Layouts.Text"
        android:text="@string/constraint_guideline_desc" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/layouts_surface"
        android:padding="12dp">
        <!-- La guía divide el ancho disponible en dos partes iguales. -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <Button
            android:id="@+id/btn_inicio_guia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/inicio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guia"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btn_fin_guia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/fin"
            app:layout_constraintStart_toEndOf="@id/guia"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>

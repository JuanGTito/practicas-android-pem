<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        style="@style/Layouts.Column"
        android:layout_height="wrap_content">
        <TextView
            style="@style/Layouts.Title"
            android:text="@string/grid_calculator" />

        <TextView
            style="@style/Layouts.Text"
            android:text="@string/grid_calculator_desc" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/layouts_surface"
            android:padding="12dp">
            <TextView
                style="@style/Layouts.Text"
                android:text="@string/digito_0"
                android:id="@+id/display"
                android:layout_width="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:minHeight="64dp"
                android:gravity="end|center_vertical"
                android:padding="8dp"
                android:background="@color/white"
                android:textSize="30sp"
                android:accessibilityLiveRegion="polite" />

            <GridLayout
                android:id="@+id/grid_botones"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:layout_marginTop="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/display"
                app:layout_constraintBottom_toBottomOf="parent">
                <Button
                    android:id="@+id/btn_7"
                    style="@style/Layouts.GridButton"
                    android:text="@string/digito_7"
                    android:layout_row="0"
                    android:layout_column="0" />

                <Button
                    android:id="@+id/btn_8"
                    style="@style/Layouts.GridButton"
                    android:text="@string/digito_8"
                    android:layout_row="0"
                    android:layout_column="1" />

                <Button
                    android:id="@+id/btn_9"
                    style="@style/Layouts.GridButton"
                    android:text="@string/digito_9"
                    android:layout_row="0"
                    android:layout_column="2" />

                <Button
                    android:id="@+id/btn_dividir"
                    style="@style/Layouts.GridButton"
                    android:text="@string/dividir"
                    android:layout_row="0"
                    android:layout_column="3" />

                <Button
                    android:id="@+id/btn_4"
                    style="@style/Layouts.GridButton"
                    android:text="@string/digito_4"
                    android:layout_row="1"
                    android:layout_column="0" />

                <Button
                    android:id="@+id/btn_5"
                    style="@style/Layouts.GridButton"
                    android:text="@string/digito_5"
                    android:layout_row="1"
                    android:layout_column="1" />

                <Button
                    android:id="@+id/btn_6"
                    style="@style/Layouts.GridButton"
                    android:text="@string/digito_6"
                    android:layout_row="1"
                    android:layout_column="2" />

                <Button
                    android:id="@+id/btn_multiplicar"
                    style="@style/Layouts.GridButton"
                    android:text="@string/multiplicar"
                    android:layout_row="1"
                    android:layout_column="3" />

                <Button
                    android:id="@+id/btn_1"
                    style="@style/Layouts.GridButton"
                    android:text="@string/digito_1"
                    android:layout_row="2"
                    android:layout_column="0" />

                <Button
                    android:id="@+id/btn_2"
                    style="@style/Layouts.GridButton"
                    android:text="@string/digito_2"
                    android:layout_row="2"
                    android:layout_column="1" />

                <Button
                    android:id="@+id/btn_3"
                    style="@style/Layouts.GridButton"
                    android:text="@string/digito_3"
                    android:layout_row="2"
                    android:layout_column="2" />

                <Button
                    android:id="@+id/btn_restar"
                    style="@style/Layouts.GridButton"
                    android:text="@string/restar"
                    android:layout_row="2"
                    android:layout_column="3" />

                <Button
                    android:id="@+id/btn_0"
                    style="@style/Layouts.GridButton"
                    android:text="@string/digito_0"
                    android:layout_row="3"
                    android:layout_column="0"
                    android:layout_columnSpan="2"
                    android:layout_columnWeight="2" />

                <Button
                    android:id="@+id/btn_decimal"
                    style="@style/Layouts.GridButton"
                    android:text="@string/decimal"
                    android:layout_row="3"
                    android:layout_column="2" />

                <Button
                    android:id="@+id/btn_sumar"
                    style="@style/Layouts.GridButton"
                    android:text="@string/sumar"
                    android:layout_row="3"
                    android:layout_column="3" />

                <Button
                    android:id="@+id/btn_limpiar"
                    style="@style/Layouts.GridButton"
                    android:text="@string/limpiar"
                    android:layout_row="4"
                    android:layout_column="0"
                    android:layout_columnSpan="2"
                    android:layout_columnWeight="2" />

                <Button
                    android:id="@+id/btn_igual"
                    style="@style/Layouts.GridButton"
                    android:text="@string/igual"
                    android:layout_row="4"
                    android:layout_column="2"
                    android:layout_columnSpan="2"
                    android:layout_columnWeight="2" />
            </GridLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</ScrollView>

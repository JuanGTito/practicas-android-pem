<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Layouts.Column">
    <TextView
        style="@style/Layouts.Title"
        android:text="@string/linear_basic" />

    <TextView
        style="@style/Layouts.Text"
        android:text="@string/linear_basic_desc" />

    <TextView
        style="@style/Layouts.Text"
        android:text="@string/vertical_example" />

    <Button
        android:id="@+id/btn_enviar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/enviar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            style="@style/Layouts.Text"
            android:text="@string/horizontal_example"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_opcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/elegir" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        style="@style/Layouts.Column"
        android:layout_height="wrap_content">
        <TextView
            style="@style/Layouts.Title"
            android:text="@string/frame_basic" />

        <TextView
            style="@style/Layouts.Text"
            android:text="@string/frame_basic_desc" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="12dp"
            android:background="@color/layouts_surface">
            <ImageView
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />

            <TextView
                style="@style/Layouts.Text"
                android:text="@string/capa_frontal"
                android:id="@+id/txt_capa"
                android:layout_width="wrap_content"
                android:layout_gravity="center"
                android:padding="12dp"
                android:textColor="@color/white"
                android:background="@color/layouts_primary" />
        </FrameLayout>

        <Button
            android:id="@+id/btn_capa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/alternar_capa" />
    </LinearLayout>
</ScrollView>

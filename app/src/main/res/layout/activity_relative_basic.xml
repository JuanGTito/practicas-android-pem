<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Layouts.Column">
    <TextView
        style="@style/Layouts.Title"
        android:text="@string/relative_basic" />

    <TextView
        style="@style/Layouts.Text"
        android:text="@string/relative_basic_desc" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="@color/layouts_surface">
        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:id="@+id/img_perfil"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true" />

        <TextView
            style="@style/Layouts.Text"
            android:text="@string/perfil_nombre"
            android:id="@+id/txt_nombre"
            android:layout_toEndOf="@id/img_perfil"
            android:layout_alignTop="@id/img_perfil"
            android:layout_marginStart="12dp"
            android:textStyle="bold" />

        <TextView
            style="@style/Layouts.Text"
            android:text="@string/perfil_correo"
            android:id="@+id/txt_correo"
            android:layout_below="@id/txt_nombre"
            android:layout_alignStart="@id/txt_nombre" />

        <Button
            android:id="@+id/btn_editar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/editar_perfil"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/txt_correo"
            android:layout_marginTop="12dp" />
    </RelativeLayout>
</LinearLayout>

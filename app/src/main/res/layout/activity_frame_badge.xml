<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        style="@style/Layouts.Column"
        android:layout_height="wrap_content">
        <TextView
            style="@style/Layouts.Title"
            android:text="@string/frame_badge" />

        <TextView
            style="@style/Layouts.Text"
            android:text="@string/frame_badge_desc" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="12dp"
            android:background="@color/layouts_surface">
            <ImageView
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />

            <TextView
                style="@style/Layouts.Text"
                android:text="@string/oferta"
                android:id="@+id/badge_oferta"
                android:layout_width="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:padding="8dp"
                android:textColor="@color/white"
                android:background="@color/layouts_badge" />
        </FrameLayout>

        <Button
            android:id="@+id/btn_oferta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/alternar_oferta" />
    </LinearLayout>
</ScrollView>

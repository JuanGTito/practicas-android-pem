<?xml version="1.0" encoding="utf-8"?>
<resources>
    <item name="chip_opcion" type="id" />

    <style name="TextAppearance.Buttons.Section" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Buttons.Chip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="closeIconVisible">true</item>
    </style>

    <style name="Widget.Buttons.RadioTransporte" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/bg_buttons_checked</item>
    </style>
</resources>
